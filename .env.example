# Polymarket Wallet Private Key
# Export from Polymarket: Login -> Cash -> Three dots -> Export Private Key
# WARNING: Never share this key or commit it to version control!
PK=your_private_key_here

# Alternative environment variable name
# POLYMARKET_PRIVATE_KEY=your_private_key_here

# Funder address (for proxy/Safe wallets)
# POLYMARKET_FUNDER=0x...

# Signature type: 0 = EOA, 1 = Magic/Email, 2 = Proxy
# POLYMARKET_SIGNATURE_TYPE=0
